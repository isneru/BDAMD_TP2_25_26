      DTS:EvaluateAsExpression="True"
      DTS:Expression="&quot;IF EXISTS (SELECT * FROM Steinway.sys.tables WHERE name = '&quot; + @[User::TableName] + &quot;')&#xA; BEGIN&#xA;    INSERT INTO [Steinway_Staging].[dbo].[&quot; + REPLACE(@[User::TableName], &quot;Departaments&quot;, &quot;Departments&quot;) + &quot;]&#xA;    SELECT * FROM [Steinway].[dbo].[&quot; + @[User::TableName] + &quot;]&#xA; END&quot;"
      DTS:IncludeInDebugDump="2345"
      DTS:Namespace="User"
      DTS:ObjectName="SQL_Insert">
      <DTS:VariableValue
        DTS:DataType="8">IF EXISTS (SELECT * FROM Steinway.sys.tables WHERE name = '')
 BEGIN
    INSERT INTO [Steinway_Staging].[dbo].[]
    SELECT * FROM [Steinway].[dbo].[]
 END</DTS:VariableValue>
    </DTS:Variable>
